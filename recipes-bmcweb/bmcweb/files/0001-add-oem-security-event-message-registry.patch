From ff5b71a2f1859ff51443cc54aad46d1a3598578f Mon Sep 17 00:00:00 2001
From: HTTPS-Guard <noreply@example.com>
Date: Thu, 2 Jul 2026 10:39:52 +0800
Subject: [PATCH] Add OemSecurityEvent message registry for HTTPS-Guard

Upstream-Status: Inappropriate [OE-specific]

Registers a compiled-in Redfish message registry for HTTPS-Guard's own
OemSecurityEvent MessageIds, so bmcweb's FilesystemLogWatcher can resolve
their real per-message severity instead of falling back to a borrowed
OpenBMC.0.5.GeneralFirmwareSecurityViolation (always Critical). This is
specific to the HTTPS-Guard OEM extension in this layer, not a general
bmcweb improvement, so it is not intended for upstream submission.

---
 .../oem_security_event_message_registry.hpp   | 160 +++++++++++++++++++++++
 redfish-core/include/registries_selector.hpp  |   2 +
 2 files changed, 162 insertions(+)
 create mode 100644 redfish-core/include/registries/oem_security_event_message_registry.hpp

diff --git a/redfish-core/include/registries/oem_security_event_message_registry.hpp b/redfish-core/include/registries/oem_security_event_message_registry.hpp
new file mode 100644
index 0000000..a7cfb05
--- /dev/null
+++ b/redfish-core/include/registries/oem_security_event_message_registry.hpp
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright HTTPS-Guard project.
+#pragma once
+/****************************************************************
+ * HTTPS-Guard OEM Redfish Message Registry.
+ *
+ * Hand-authored (not DMTF/parse_registries.py generated) to mirror
+ * redfish-core/include/registries/OemSecurityEvent.1.0.0.json served at
+ * /redfish/v1/Registries/OemSecurityEvent.1.0.0/. Keep both in sync.
+ *
+ * Message templates take a single %1 argument: the fully-rendered
+ * description string the https-guard daemon already builds, so callers
+ * (https-guard-event-bridge.sh) pass it through as-is rather than
+ * decomposing it into separate MessageArgs.
+ ***************************************************************/
+#include "registries.hpp"
+
+#include <array>
+
+// clang-format off
+
+namespace redfish::registries
+{
+struct OemSecurityEvent
+{
+static constexpr Header header = {
+    "Copyright HTTPS-Guard project.",
+    "#MessageRegistry.v1_4_0.MessageRegistry",
+    1,
+    0,
+    0,
+    "HTTPS Guard Security Event Registry",
+    "en",
+    "This registry defines security and anomaly events detected at the kernel layer via eBPF.",
+    "OemSecurityEvent",
+    "HTTPS-Guard",
+};
+
+static constexpr const char* url =
+    "/redfish/v1/Registries/OemSecurityEvent.1.0.0/OemSecurityEvent.1.0.0.json";
+
+static constexpr std::array registry =
+{
+    MessageEntry{
+        "HttpsTlsVersionViolation",
+        {
+            "An incoming or outgoing HTTPS connection attempted to use a banned TLS version.",
+            "%1",
+            "Critical",
+            1,
+            {
+                "string",
+            },
+            "Upgrade the client application to support TLS 1.2 or TLS 1.3.",
+        }},
+    MessageEntry{
+        "HttpsPayloadAnomalyDetected",
+        {
+            "An HTTP/HTTPS request contained strings indicative of a web attack payload.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Inspect process behavior, validate source endpoint, and review server access logs.",
+        }},
+    MessageEntry{
+        "HttpsTrafficObserved",
+        {
+            "Normal HTTPS traffic was observed.",
+            "%1",
+            "OK",
+            1,
+            {
+                "string",
+            },
+            "None.",
+        }},
+    MessageEntry{
+        "HttpsCertificateAccessViolation",
+        {
+            "An unrecognized process attempted to access the BMC's HTTPS certificate or private key file.",
+            "%1",
+            "Critical",
+            1,
+            {
+                "string",
+            },
+            "Verify the accessing process is authorized; investigate for key theft or process impersonation.",
+        }},
+    MessageEntry{
+        "HttpsWeakCipherSuiteDetected",
+        {
+            "An incoming HTTPS connection offered a cryptographically weak cipher suite.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Review client TLS configuration; disable support for weak cipher suites if this traffic is expected to continue.",
+        }},
+    MessageEntry{
+        "HttpsSniAnomalyDetected",
+        {
+            "An incoming HTTPS connection's TLS Server Name Indication did not match the expected hostname.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Verify the client is targeting the correct BMC hostname; investigate for domain fronting or misdirected traffic.",
+        }},
+    MessageEntry{
+        "HttpsConnectionRateViolation",
+        {
+            "A source exceeded the configured connection-rate threshold, indicating possible SYN flood, port scan, or volumetric abuse.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Investigate the source IP; the connection has been blocklisted if enforcement is enabled.",
+        }},
+    MessageEntry{
+        "HttpsSlowlorisDetected",
+        {
+            "A source held an unusually high number of slow, incomplete HTTPS connections open, indicative of a Slowloris-style resource-exhaustion attempt.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Investigate the source IP; consider tightening connection-timeout settings.",
+        }},
+    MessageEntry{
+        "HttpsTlsRenegotiationStorm",
+        {
+            "A source initiated an unusually high number of TLS handshakes within a short window, indicative of a renegotiation-based denial-of-service attempt.",
+            "%1",
+            "Warning",
+            1,
+            {
+                "string",
+            },
+            "Investigate the source IP; the connection has been blocklisted if enforcement is enabled.",
+        }},
+};
+
+};
+// clang-format on
+
+[[gnu::constructor]] inline void registerOemSecurityEvent()
+{ registerRegistry<OemSecurityEvent>(); }
+
+} // namespace redfish::registries
